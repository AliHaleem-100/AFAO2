<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
        integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg=="
        crossorigin="anonymous" referrerpolicy="no-referrer">
    <%- include("../components/head.ejs") -%>
        <link rel="stylesheet" href="/styles/home/home.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css" />
</head>

<body style="background:#e6e6e6">
    <%- include("../components/header.ejs") -%>


        <!-- hero section -->
        <section class="hero-container">
            <div class="background">
                <picture>
                    <source media="(max-width:800px)" srcset="/images/800.webp" width="800">
                    <img src="/images/hero_banner.webp"
                        srcset="/images/hero-1280.webp 1280w, /images/hero-1920.webp 1920w" alt="hero banner"
                        fetchpriority="high" width="1920" height="1280">
                </picture>
            </div>
            <div class="hero-content container">
                <div class="content">
                    <h1 class="title">Empowerment Starts Here</h1>
                    <p class="hero-subtitle">At All For All Organization-AFAO, we empower individuals in need, immigrant
                        families, low-income households, and job seekers by expanding access to practical knowledge,
                        essential skills, supportive services, and opportunities that help them overcome barriers and
                        move toward lasting economic self-sufficiency.</p>
                </div>
                <button>
                    <a class="btn outline-btn" href="/programs">Programs</a>
                </button>
                <button class="apply-btn">
                    <a class="btn outline-btn" href="/apply">Apply</a>
                </button>
            </div>
        </section>

        <!-- trust bar -->

        <section class="trust-bar">
            <div class="trust-container container">
                <ul class="trust-menu">
                    <li class="trust-item">
                        <i class="fa-solid fa-hand-holding-heart"></i>
                        <div class="content">
                            <h3 class="trust-title">Tax-Exempt Organization</h3>
                            <span class="trust-subtitle">IRS-Recognized 501(c)(3)</span>
                        </div>
                    </li>
                    <li class="trust-item">
                        <i class="fa-solid fa-location-dot"></i>
                        <div class="content">
                            <h3 class="trust-title">Service Area</h3>
                            <span class="trust-subtitle">Sacramento, California</span>
                        </div>
                    </li>
                    <li class="trust-item">
                        <i class="fa-solid fa-people-roof"></i>
                        <div class="content">
                            <h3 class="trust-title">Audience</h3>
                            <span class="trust-subtitle">Individuals in need • Immigrants • Low-Income Families • Job
                                seekers</span>
                        </div>
                    </li>
                </ul>
            </div>
        </section>

        <!-- about section -->
        <section class="about-container container">
            <div class="about-content">
                <div class="content">
                    <h1 class="about-title title">About Us</h1>
                    <p class="about-subtitle">All For All Organization-AFAO is a California nonprofit public benefit
                        corporation committed to
                        reducing poverty by empowering individuals in need, immigrant families, and low-income
                        households to achieve lasting economic self-sufficiency.</p>
                </div>
                <button>
                    <a class="btn outline-btn about-btn" href="/about">see more
                        <i class="fa-solid fa-arrow-right-long"></i>
                    </a>
                </button>
            </div>
            <img src="/images/about.webp" alt="about image">
        </section>

        <!-- programs slider -->


